{
  "name": "recruitex",
  "private": true,
  "version": "0.0.1",
  "workspaces": [
    "packages/*",
    "services/*",
    "frontend"
  ],
  "scripts": {
    "db:generate": "npm run generate -w @app/db",
    "db:migrate": "npm run migrate -w @app/db",
